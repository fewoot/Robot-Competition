//注意arduino UNO 板可以存储1kb的数据
#include <EEPROM.h>
//第一个地址，每个地址可以存储0-255字节的值
int addr = 0;

struct MyObject {
    long time_record;
    int status;
};


void re_record(){
    MyObject luru;
    Serial.begin(9600);
    addr = 0;
    for(;addr<1015;){
        EEPROM.get(addr,luru);
        Serial.print(luru.time_record);
        Serial.print(" : ");
        Serial.println(luru.status);
        addr += sizeof(MyObject);
    }
}

void setup(){
    pinMode(13,OUTPUT);
    re_record();
}
void loop(){
    digitalWrite(13,HIGH);
    delay(1000);
    digitalWrite(13,LOW);
    delay(100);
    digitalWrite(13,HIGH);
    delay(100);
    digitalWrite(13,LOW);
    delay(100);
}
