//注意arduino UNO 板可以存储1kb的数据
#include <EEPROM.h>
void Edelete(){
    for(int i=0;i<=1024;++i){
        EEPROM.write(i,0);
    }
}
void setup(){
    pinMode(13,OUTPUT);
    Edelete();
}
void loop(){
    digitalWrite(13,HIGH);
    delay(1000);
    digitalWrite(13,LOW);
    delay(100);
    digitalWrite(13,HIGH);
    delay(100);
    digitalWrite(13,LOW);
    delay(100);  
}

